{
  "manifest_version": 3,
  "name": "X Follow Review",
  "version": "0.7.6",
  "description": "Review X follows in a list-detail workspace with direct GraphQL synchronization and no background worker tabs.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open X Follow Review diagnostics"
  },
  "options_page": "probe.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["page-hook.js", "graphql-page-v2.js", "graphql-xhr.js", "actions-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js", "review-ui-v2.js", "graphql-client.js", "layout-fix.js", "ui-polish.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
