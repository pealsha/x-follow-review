{
  "manifest_version": 3,
  "name": "X Follow Review",
  "version": "0.9.0",
  "description": "Review X follows with cache-first direct GraphQL synchronization.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open X Follow Review diagnostics"
  },
  "options_page": "probe.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["graphql-bootstrap.js", "page-hook.js", "graphql-page.js", "graphql-xhr.js", "actions-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js", "review-ui.js", "graphql-client.js", "ui-metadata.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
